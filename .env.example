# Google Gemini API key (keep this strictly on the server — NEVER prefix with VITE_)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model to use (defaults to gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Port for standalone server (npm run server)
API_PORT=3001

# Gmail SMTP for Contact Form (generate a 16-char App Password at https://myaccount.google.com/apppasswords)
GMAIL_USER=lartab.abderrahmane@gmail.com
GMAIL_APP_PASSWORD=your_16_char_gmail_app_password
